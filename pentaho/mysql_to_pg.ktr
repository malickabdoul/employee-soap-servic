<attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps>
<GUI><xloc>440</xloc><yloc>160</yloc><draw>Y</draw></GUI></step><step><name>Valider regles</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/>
<copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type>
<jsScript_name>Validation</jsScript_name><jsScript_script>// Contrôle des règles du modèle commun d'employé.
// motif reste null si la ligne est valide, sinon il contient la liste des erreurs.
var erreurs = [];
var reEmail = /^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$/;
if (matricule == null || matricule == "") erreurs.push("matricule obligatoire");
if (nom == null || nom == "") erreurs.push("nom obligatoire");
if (prenom == null || prenom == "") erreurs.push("prenom obligatoire");
if (email == null || !reEmail.test(email)) erreurs.push("email invalide");
if (departement_norm == null || departement_norm == "") erreurs.push("departement inconnu: " + departement);
if (poste == null || poste == "") erreurs.push("poste obligatoire");
if (salaire == null || salaire &lt;= 0) erreurs.push("salaire doit etre &gt; 0");
if (date_naissance == null) erreurs.push("date_naissance obligatoire");
if (date_embauche == null) erreurs.push("date_embauche obligatoire");
var statutOk = (statut == "ACTIF" || statut == "SUSPENDU" || statut == "SORTI");
if (!statutOk) erreurs.push("statut invalide: " + statut);
var motif = erreurs.length &gt; 0 ? erreurs.join("; ") : null;
</jsScript_script></jsScript></jsScripts>
<fields><field><name>motif</name><rename>motif</rename><type>String</type><length>255</length><precision>-1</precision><replace>N</replace></field></fields>
<attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps>
