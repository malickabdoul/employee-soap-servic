<intervalMinutes>60</intervalMinutes><hour>12</hour><minutes>0</minutes><weekDay>1</weekDay><DayOfMonth>1</DayOfMonth>
<parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>40</xloc><yloc>160</yloc><attributes_kjc/></entry><entry><name>Vider zone de transit</name><description/><type>SQL</type><attributes/><sql>TRUNCATE TABLE stg_employee;</sql><useVariableSubstitution>F</useVariableSubstitution><sqlfromfile>F</sqlfromfile><sqlfilename/><sendOneStatement>F</sendOneStatement><connection>pg_reference</connection>
<parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>200</xloc><yloc>160</yloc><attributes_kjc/></entry><entry><name>MySQL vers transit</name><description/><type>TRANS</type><attributes/><specification_method>filename</specification_method><trans_object_id/><filename>${Internal.Entry.Current.Directory}/mysql_to_pg.ktr</filename>
<transname/><arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row>
<clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time>
