<follow_abort_remote>N</follow_abort_remote><create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work>
<run_configuration>Pentaho local</run_configuration><suppress_result_data>N</suppress_result_data><parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
<parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>380</xloc><yloc>160</yloc><attributes_kjc/></entry><entry><name>Fusionner dans employee</name><description/><type>SQL</type><attributes/><sql>-- Fusion de la zone de transit dans la base de référence (exécutée par le job Pentaho).
-- Règle de conflit : la modification la plus récente gagne. Une ligne modifiée via SOAP
-- après la dernière modification MySQL n'est donc jamais écrasée.
INSERT INTO employee AS e (matricule, nom, prenom, email, telephone, date_naissance, date_embauche,
                           departement, poste, salaire, statut, source, updated_at)
SELECT matricule, nom, prenom, email, telephone, date_naissance, date_embauche,
       departement, poste, salaire, statut, 'MYSQL', updated_at
FROM stg_employee
ON CONFLICT (matricule) DO UPDATE SET
  nom = EXCLUDED.nom, prenom = EXCLUDED.prenom, email = EXCLUDED.email,
  telephone = EXCLUDED.telephone, date_naissance = EXCLUDED.date_naissance,
  date_embauche = EXCLUDED.date_embauche, departement = EXCLUDED.departement,
  poste = EXCLUDED.poste, salaire = EXCLUDED.salaire, statut = EXCLUDED.statut,
  source = 'MYSQL', updated_at = EXCLUDED.updated_at
WHERE e.updated_at &lt; EXCLUDED.updated_at;
</sql><useVariableSubstitution>F</useVariableSubstitution><sqlfromfile>F</sqlfromfile><sqlfilename/><sendOneStatement>F</sendOneStatement><connection>pg_reference</connection>
<parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>560</xloc><yloc>160</yloc><attributes_kjc/></entry><entry><name>Journaliser execution</name><description/><type>SQL</type><attributes/><sql>INSERT INTO sync_run(direction, rows_merged, rows_rejected)
SELECT 'MYSQL_TO_PG',
       (SELECT count(*) FROM stg_employee),
       (SELECT count(*) FROM sync_reject WHERE rejected_at &gt;= now() - interval '5 minutes');</sql><useVariableSubstitution>F</useVariableSubstitution><sqlfromfile>F</sqlfromfile><sqlfilename/><sendOneStatement>F</sendOneStatement><connection>pg_reference</connection>
<parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>740</xloc><yloc>160</yloc><attributes_kjc/></entry><entry><name>Succes</name><description/><type>SUCCESS</type><attributes/>
<parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>920</xloc><yloc>160</yloc><attributes_kjc/></entry></entries>
<hops><hop><from>START</from><to>Vider zone de transit</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop><hop><from>Vider zone de transit</from><to>MySQL vers transit</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop><hop><from>MySQL vers transit</from><to>Fusionner dans employee</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop><hop><from>Fusionner dans employee</from><to>Journaliser execution</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop><hop><from>Journaliser execution</from><to>Succes</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop></hops>
